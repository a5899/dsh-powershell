{
  "name": "dsh-powershell",
  "version": "1.0.8",
  "description": "DSH plugin: run PowerShell commands directly from the agent (inline code, no script files), with an explicit UAC-elevated tool and a background job tool that makes long-running output visible while it runs. Registers psh / psh_elevated / psh_job / psh_kill / psh_status plus an always-on 'prefer commands over scripts' policy.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/elevate.js",
    "lib/jobs.js",
    "lib/policy.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/schema-check.mjs && node test/run.mjs && node test/jobs-probe.mjs",
    "test:schema": "node test/schema-check.mjs",
    "test:jobs": "node test/jobs-probe.mjs",
    "test:uac": "node test/uac-probe.mjs",
    "test:uac-cancel": "node test/uac-probe.mjs --cancel",
    "test:uac-e2e": "node test/e2e-uac.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "powershell",
    "pwsh",
    "uac",
    "elevation",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/a5899/dsh-powershell.git"
  },
  "homepage": "https://github.com/a5899/dsh-powershell#readme",
  "bugs": {
    "url": "https://github.com/a5899/dsh-powershell/issues"
  },
  "author": "a5899",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
